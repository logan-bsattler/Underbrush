{
  "name": "underbrush",
  "private": true,
  "version": "0.1.0",
  "description": "Underbrush: a cozy mushroom foraging and cultivation game (mobile web build).",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "vite-node scripts/simulate.ts"
  },
  "dependencies": {
    "preact": "^10.26.9"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
